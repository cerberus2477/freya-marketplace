<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:FreyaMarketplace.ViewModel"
             x:Class="FreyaMarketplace.View.Listings.ListingDetailsPage"
             Title="Hirdetés részletei"
             x:DataType="viewmodel:ListingDetailsViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Image Gallery -->
            <CollectionView ItemsSource="{Binding Listing.Media}" 
                            HeightRequest="150" 
                            ItemsLayout="HorizontalList">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Image Source="{Binding .}" WidthRequest="150" Margin="5"
                               Style="{StaticResource ListingImage}">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:ListingDetailsViewModel}}, Path=OpenImageViewerCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Image.GestureRecognizers>
                        </Image>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Title -->
            <Label Text="{Binding Listing.Title}" 
                   Style="{StaticResource LargeLabel}" 
                   FontAttributes="Bold" />

            <!-- === Card: Alapadatok === -->
            <Border Style="{StaticResource ListingContainer}">
                <VerticalStackLayout>

                    <!-- Price -->
                    <Label Text="{Binding Listing.Price, StringFormat='{0:N0} Ft'}" 
                           Style="{StaticResource LargeLabel}" 
                           FontAttributes="Bold" />

                    <!-- City with Icon Placeholder -->
                    <Label Text="{Binding Listing.City, StringFormat='📍 Város: {0}'}" 
                           Style="{StaticResource MediumLabel}" />

                    <!-- Created/Updated Timestamp with Icon Placeholder -->
                    <Label Text="{Binding Listing.CreatedAtFormattedLong, StringFormat='🕒 Feladás ideje: {0} (Frissítve: {1})'}" 
                           Style="{StaticResource MediumLabel}"/>
                </VerticalStackLayout>
            </Border>
            
            <!-- === Card: Tulajdonságok === -->
            <Border Style="{StaticResource ListingContainer}">
                <VerticalStackLayout>
                    <Label Text="Tulajdonságok" Style="{StaticResource CardTitleLabel}" />

                    <!-- Summary Line (Count, Name, Stage) -->
                    <Label Style="{StaticResource MediumLabel}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding Listing.Count}" FontAttributes="Bold" />
                                <Span Text=" db " />
                                <Span Text="{Binding Listing.PlantName}" />
                                <Span Text=" " />
                                <Span Text="{Binding Listing.StageName}" FontAttributes="Italic" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <!-- Additional Plant Info -->
                    <Label Text="{Binding Listing.PlantName, StringFormat='Növény: {0}'}" 
                           Style="{StaticResource MediumLabel}" />
                    <Label Text="{Binding Listing.PlantType, StringFormat='Típus: {0}'}" 
                           Style="{StaticResource MediumLabel}" />
                </VerticalStackLayout>
            </Border>

            <!-- === Card: Leírás === -->
            <Border Style="{StaticResource ListingContainer}">
                <VerticalStackLayout>
                    <Label Text="Leírás" Style="{StaticResource CardTitleLabel}" />
                    <Label Text="{Binding Listing.Description}" 
                           Style="{StaticResource MediumLabel}" />
                </VerticalStackLayout>
            </Border>


            <!-- === Card: Hirdető Adatai === -->
            <Border Style="{StaticResource ListingContainer}">
                <VerticalStackLayout>
                    <Label Text="Hirdető adatai" Style="{StaticResource CardTitleLabel}" />

                    <Label Text="{Binding Listing.Username}" 
                           Style="{StaticResource MediumLabel}" />

                    <!-- Reveal Buttons & Copiable Info -->
                    <!-- These will need to be bound to commands and state in the ViewModel -->

                    <!-- Email Reveal Button -->
                    <Button Text="Elérhetőség felfedése"
                            Command="{Binding RevealEmailCommand}"
                            Style="{StaticResource PrimaryButton}" />

                    <!-- Email shown after reveal -->
                    <!-- Optional: add TapGestureRecognizer for opening mail app -->

                    <!-- City Reveal Button (Only if city exists) -->
                    <Button Text="Helység felfedése"
                            Command="{Binding RevealCityCommand}"
                            Style="{StaticResource PrimaryButton}"
                            IsVisible="{Binding Listing.City, Converter={StaticResource NullToBooleanConverter}}" />

                    <!-- Copy buttons for email/city if visible -->
                    <!-- Add small copy buttons to the right of each field once shown -->
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
