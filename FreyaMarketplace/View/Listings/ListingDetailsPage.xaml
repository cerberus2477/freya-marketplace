<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:FreyaMarketplace.ViewModel"
             x:Class="FreyaMarketplace.View.Listings.ListingDetailsPage"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             Title="Hirdetés részletei"
             x:DataType="viewmodel:ListingDetailsViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Image Gallery -->
            <StackLayout x:Name="ImageContainer" Orientation="Horizontal" Spacing="8" />

            <!-- Title -->
            <Label Text="{Binding Listing.Title}" 
                   Style="{StaticResource LargeLabel}" 
                   FontAttributes="Bold" />

            <!-- === Card: Alapadatok === -->
            <Border Style="{StaticResource ListingContainer}">
                <VerticalStackLayout>
                    <Label Text="{Binding Listing.Price, StringFormat='{0:N0} Ft'}" 
                           Style="{StaticResource LargeLabel}" 
                           FontAttributes="Bold" />

                    <Label Style="{StaticResource MediumLabel}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{x:Static viewmodel:FontAwesomeIcons.Location}" FontFamily="FontAwesome" Style="{StaticResource IconPaddingStyle}"  />
                                <Span Text="{Binding Listing.City, StringFormat='Város: {0}'}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label Style="{StaticResource MediumLabel}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{x:Static viewmodel:FontAwesomeIcons.Clock}" FontFamily="FontAwesome" Style="{StaticResource IconPaddingStyle}"/>
                                <Span Text="{Binding Listing.CreatedAtFormattedLong, StringFormat='Feladás ideje: {0} (Frissítve: {1})'}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </Border>
            
            <!-- === Card: Tulajdonságok === -->
            <Border Style="{StaticResource ListingContainer}">
                <VerticalStackLayout>
                    <Label Text="Tulajdonságok" Style="{StaticResource CardTitleLabel}" />

                    <!-- Summary Line (Count, Name, Stage) -->
                    <Label Style="{StaticResource MediumLabel}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding Listing.Count}" FontAttributes="Bold" />
                                <Span Text=" db " />
                                <Span Text="{Binding Listing.PlantName}" />
                                <Span Text=" " />
                                <Span Text="{Binding Listing.StageName}" FontAttributes="Italic" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <!-- Additional Plant Info -->
                    <Label Text="{Binding Listing.PlantName, StringFormat='Növény: {0}'}" 
                           Style="{StaticResource MediumLabel}" />
                    <Label Text="{Binding Listing.PlantType, StringFormat='Típus: {0}'}" 
                           Style="{StaticResource MediumLabel}" />
                </VerticalStackLayout>
            </Border>

            <!-- === Card: Leírás === -->
            <Border Style="{StaticResource ListingContainer}">
                <VerticalStackLayout>
                    <Label Text="Leírás" Style="{StaticResource CardTitleLabel}" />
                    <Label Text="{Binding Listing.Description}" 
                           Style="{StaticResource MediumLabel}" />
                </VerticalStackLayout>
            </Border>


            <!-- === Card: Hirdető Adatai === -->
            <Border Style="{StaticResource ListingContainer}">
                <VerticalStackLayout>
                    <Label Text="Hirdető adatai" Style="{StaticResource CardTitleLabel}" />

                    <Label Text="{Binding Listing.Username}" 
                           Style="{StaticResource MediumLabel}" />

                    <!--email section-->
                    <HorizontalStackLayout>
                        <!-- Reveal Email Button -->
                        <Button Text="Email felfedése"
                            Command="{Binding RevealEmailCommand}"
                            Style="{StaticResource PrimaryButton}"
                            IsVisible="{Binding IsEmailRevealed, Converter={StaticResource InverseBooleanConverter}}" />

                        <!--//TODO: add icon-->
                        <!-- Revealed Email with actions -->
                        <HorizontalStackLayout IsVisible="{Binding IsEmailRevealed}" Spacing="10">
                            <Button Text="{Binding Listing.User.Email}"
                                    Command="{Binding OpenEmailAppCommand}"
                                    CommandParameter="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:ListingDetailsViewModel}},
                                   Path=EmailCommandParameter}" />

                            <Button Text="📋"
                                Command="{Binding CopyToClipboardCommand}"
                                CommandParameter="{Binding Listing.User.Email}" />  
                        </HorizontalStackLayout>
                    </HorizontalStackLayout>

                    <!-- City section -->
                    <HorizontalStackLayout IsVisible="{Binding IsCityRevealButtonVisible}">
                        <!-- Reveal City Button -->
                        <Button Text="Helység felfedése"
                            Command="{Binding RevealCityCommand}"
                            Style="{StaticResource PrimaryButton}"
                            IsVisible="{Binding IsCityRevealed, Converter={StaticResource InverseBooleanConverter}}" />

                        <!-- Revealed City with actions -->
                        <HorizontalStackLayout IsVisible="{Binding IsCityRevealed}" Spacing="10">
                            <Button Text="{Binding Listing.User.City}"
                                Command="{Binding OpenMapAppCommand}" />

                            <Button Text="📋"
                                Command="{Binding CopyToClipboardCommand}"
                                CommandParameter="{Binding Listing.User.City}" />
                        </HorizontalStackLayout>
                    </HorizontalStackLayout>


                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
