<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FreyaMarketplace.View.StartingPages.LoginPage"
             xmlns:viewmodel="clr-namespace:FreyaMarketplace.ViewModel"
             x:DataType="viewmodel:AuthViewModel"
             Title="Bejelentkezés">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- FORM SIDE -->
        <Grid Grid.Column="0">

            <!-- Decorative top-left -->
            <Image Source="rick.png" Opacity="0.1"
                   Rotation="30" Aspect="AspectFit"
                   TranslationX="-70" TranslationY="-70"
                   WidthRequest="300"
                   HorizontalOptions="Start" VerticalOptions="Start"
                   InputTransparent="True" />

            <!-- Decorative bottom-right -->
            <Image Source="spicy.png" Opacity="0.1"
                   Rotation="-40" Aspect="AspectFit"
                   TranslationX="70" TranslationY="70"
                   WidthRequest="300"
                   HorizontalOptions="End" VerticalOptions="End"
                   InputTransparent="True" />

            <!-- Main form layout -->
            <VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="15"
                                 Padding="30"
                                 MaximumWidthRequest="400"
                                 MinimumWidthRequest="300">

                <Image Source="logo_green.png" HeightRequest="80" />
                <Label Text="Freya's Garden"
                       Style="{StaticResource TitleLogoLabel}"
                       HorizontalOptions="Center" />
                <Label Text="Örülünk hogy újra itt vagy!"
                       HorizontalOptions="Center" 
                       Style="{StaticResource Header2}"/>

                <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="5">
                    <Label Text="Nincs még fiókod?"  Style="{StaticResource GrayLabel}" />
                    <Label Text="Regisztráció" Style="{StaticResource GreenLabel}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRegisterClicked" />
                        </Label.GestureRecognizers>
                    </Label>
                </StackLayout>

                <VerticalStackLayout Style="{StaticResource FormField}">
                    <Label Text="E-mail cím:" />
                    <Entry Text="{Binding UserEmail}" />
                    <Label Text="{Binding EmailError}" Style="{StaticResource WarningLabel}" IsVisible="{Binding IsEmailErrorVisible}" />
                </VerticalStackLayout>

                <VerticalStackLayout Style="{StaticResource FormField}">
                    <Label Text="Jelszó:" />
                    <Grid ColumnSpacing="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Entry Grid.Column="0"
                           Text="{Binding UserPassword}"
                           IsPassword="{Binding IsPasswordHidden}" />
                        <Button Grid.Column="1"
                            WidthRequest="80"
                            Text="{Binding PasswordButtonText}"
                            Command="{Binding TogglePasswordVisibilityCommand}" />
                    </Grid>
                    <Label Text="{Binding PasswordError}" Style="{StaticResource WarningLabel}" IsVisible="{Binding IsPasswordErrorVisible}" />
                </VerticalStackLayout>

                <Button Text="Bejelentkezés" Style="{StaticResource PrimaryButton}" Command="{Binding LoginCommand}" />

                <Label Text="Elfelejtetted a jelszavad?" Style="{StaticResource GreenLabel}" HorizontalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="ForgotPassword_Tapped" />
                    </Label.GestureRecognizers>
                </Label>

            </VerticalStackLayout>
        </Grid>

        <!-- IMAGE SIDE with ActivityIndicator overlay -->
        <Grid Grid.Column="1" IsVisible="{Binding IsWideScreen}" >
            <Image Source="hero2.jpeg"
               Aspect="AspectFill"
               />

            <ActivityIndicator 
            Style="{StaticResource ActivityIndicatorStyle}"
            IsRunning="{Binding IsBusy}" 
            IsVisible="{Binding IsBusy}"
            HorizontalOptions="Center"
            VerticalOptions="Center" />
        </Grid>

    </Grid>
</ContentPage>
