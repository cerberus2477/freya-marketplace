<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FreyaMarketplace.View.StartingPages.GreetingPage"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             Title="Welcome"
             Shell.NavBarIsVisible="False"
             Shell.PresentationMode="Modal">

    <VerticalStackLayout Padding ="20" Spacing="10">
        <Image Source="logo_white.png"
               HorizontalOptions="Center"
               Style="{StaticResource LogoImage}"/>
        <Label Text="Üdvözlünk a FreyaMarketplace-n!"
               Style="{StaticResource LargeLabel}"
               HorizontalOptions="Center" />
        <Button Text="Bejelentkezés"
                Style="{StaticResource PrimaryButton}"
                Clicked="OnLoginClicked"
                HorizontalOptions="Center" />
        <Button Text="Regisztráció"
                Style="{StaticResource BaseButton}"
                Clicked="OnSignupClicked"
                HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>
